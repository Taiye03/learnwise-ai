# .env.example — NON-secret settings. Copied to /etc/tutor-harness/env by deploy/setup_host.sh.
# Secrets (API key, DB password, pepper, bearer token) are systemd credentials, not lines here.
# For local development only, you may export them as ANTHROPIC_API_KEY, ORACLE_PASSWORD,
# PSEUDONYM_PEPPER and API_BEARER_TOKEN instead.

ORACLE_USER=TUTOR_APP
ORACLE_DSN=localhost:1521/FREEPDB1

# Model ladder (Claude only). Change model strings here, not in code.
TUTOR_MODEL_SMALL=claude-haiku-5-5
TUTOR_MODEL_MEDIUM=claude-sonnet-5-5
TUTOR_MODEL_LARGE=claude-opus-5-5
# Relative cost weights vs. small — PLACEHOLDERS. Set from the pricing page:
# https://docs.claude.com/en/docs/about-claude/pricing
TUTOR_COST_SMALL=1
TUTOR_COST_MEDIUM=3
TUTOR_COST_LARGE=5

TUTOR_CONTEXT_BUDGET=12000
TUTOR_DAILY_TOKENS=200000
TUTOR_HOST=127.0.0.1
TUTOR_PORT=8088
